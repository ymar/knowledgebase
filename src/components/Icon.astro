---
interface Props { name: string; size?: number; class?: string }
const { name, size = 18, class: cls = '' } = Astro.props;

import { PATHS } from '../lib/icons';
const path = PATHS[name];
---
{path ? (
  <svg xmlns="http://www.w3.org/2000/svg" width={size} height={size} viewBox="0 0 24 24" fill="none"
    stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"
    aria-hidden="true" class={cls} set:html={path} />
) : (
  <span aria-hidden="true" class={cls} style={`font-size:${size}px;line-height:1`}>{name}</span>
)}
