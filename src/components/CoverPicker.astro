---
/** Cover for an object: a preset gradient or an uploaded image (stored in R2), or remove. */
import { COVER_PRESETS } from '../lib/media';

interface Props { objectId: string; hasCover: boolean; class?: string; label?: string }
const { objectId, hasCover, class: cls = '', label } = Astro.props;
const action = `/api/objects/${objectId}`;
---
<details class={cls.includes('absolute') ? cls : `relative ${cls}`} data-cover-picker>
  <summary class="inline-flex cursor-pointer list-none items-center gap-1.5 rounded-lg px-2 py-1 text-sm text-muted hover:bg-hover hover:text-ink">
    <span aria-hidden="true">▭</span> {label ?? (hasCover ? 'Change cover' : 'Cover')}
  </summary>
  <div class="absolute right-0 z-20 mt-1 w-72 rounded-xl border border-line bg-card p-2 shadow-lg">
    <form method="post" action={action} class="grid grid-cols-4 gap-1.5">
      <input type="hidden" name="_action" value="set-cover" />
      {Object.entries(COVER_PRESETS).map(([k, bg]) => (
        <button name="preset" value={k} type="submit" aria-label={`Cover ${k.slice(7)}`} class="h-10 rounded-md ring-line hover:ring-2" style={`background:${bg}`}></button>
      ))}
    </form>
    <form method="post" action={action} enctype="multipart/form-data" class="mt-2 border-t border-line pt-2">
      <input type="hidden" name="_action" value="set-cover" />
      <label class="flex cursor-pointer items-center justify-center rounded-lg border border-dashed border-line px-2 py-2 text-sm text-muted hover:bg-hover hover:text-ink">
        Upload an image
        <input type="file" name="file" accept="image/*" class="sr-only" onchange="this.form.requestSubmit()" />
      </label>
    </form>
    {hasCover && (
      <form method="post" action={action} class="mt-1">
        <input type="hidden" name="_action" value="remove-cover" />
        <button type="submit" class="w-full rounded-lg px-2 py-1.5 text-left text-sm text-muted hover:bg-hover hover:text-ink">Remove cover</button>
      </form>
    )}
  </div>
</details>
