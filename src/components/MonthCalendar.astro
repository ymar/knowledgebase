---
/**
 * Month calendar for the day page's side panel. Days with a note get a dot,
 * days with scheduled objects (date references) a colored dot. Server-rendered;
 * months change with ?month=YYYY-MM on the current page.
 */
import Icon from './Icon.astro';
import { addDays } from '../lib/format';

interface Props {
  date: string;
  today: string;
  month: string; // YYYY-MM
  gridStart: string;
  noteDays: Set<string>;
  scheduled: Record<string, number>;
}
const { date, today, month, gridStart, noteDays, scheduled } = Astro.props;
const days = Array.from({ length: 42 }, (_, i) => addDays(gridStart, i));
const shift = (n: number) => {
  const [y, m] = month.split('-').map(Number);
  const d = new Date(Date.UTC(y, m - 1 + n, 1));
  return `${d.getUTCFullYear()}-${String(d.getUTCMonth() + 1).padStart(2, '0')}`;
};
const here = Astro.url.pathname;
const title = new Intl.DateTimeFormat('en-GB', { month: 'long', year: 'numeric', timeZone: 'UTC' }).format(new Date(`${month}-01T00:00:00Z`));
const href = (d: string) => (d === today ? '/' : `/day/${d}`);
const aria = (d: string) => new Intl.DateTimeFormat('en-GB', { weekday: 'long', day: 'numeric', month: 'long', timeZone: 'UTC' }).format(new Date(`${d}T00:00:00Z`));
---
<nav aria-label="Calendar" class="rounded-xl border border-line bg-card p-3">
  <div class="mb-2 flex items-center justify-between">
    <a href={`${here}?month=${shift(-1)}`} class="flex h-8 w-8 items-center justify-center rounded-lg text-muted hover:bg-hover hover:text-ink" aria-label="Previous month"><Icon name="chevron-left" size={16} /></a>
    <span class="text-sm font-semibold">{title}</span>
    <a href={`${here}?month=${shift(1)}`} class="flex h-8 w-8 items-center justify-center rounded-lg text-muted hover:bg-hover hover:text-ink" aria-label="Next month"><Icon name="chevron-right" size={16} /></a>
  </div>
  <div class="grid grid-cols-7 text-center text-[11px] font-medium uppercase text-muted" aria-hidden="true">
    {['Mo', 'Tu', 'We', 'Th', 'Fr', 'Sa', 'Su'].map((d) => <span class="py-1">{d}</span>)}
  </div>
  <div class="grid grid-cols-7 gap-0.5">
    {days.map((d) => {
      const n = scheduled[d] ?? 0;
      const label = `${aria(d)}${noteDays.has(d) ? ', has a note' : ''}${n ? `, ${n} scheduled` : ''}`;
      return (
        <a href={href(d)} aria-label={label} aria-current={d === date ? 'date' : undefined}
          class:list={[
            'relative flex h-9 flex-col items-center justify-center rounded-lg text-sm tabular-nums transition-colors',
            d === date ? 'bg-primary font-semibold text-primary-ink' : 'hover:bg-hover',
            d.slice(0, 7) !== month && d !== date && 'text-muted/60',
            d === today && d !== date && 'font-semibold ring-1 ring-inset ring-line',
          ]}>
          {Number(d.slice(8))}
          <span class="absolute bottom-1 flex gap-0.5" aria-hidden="true">
            {noteDays.has(d) && <span class:list={['h-1 w-1 rounded-full', d === date ? 'bg-primary-ink' : 'bg-ink/45']}></span>}
            {n > 0 && <span class="h-1 w-1 rounded-full bg-[#2563eb]"></span>}
          </span>
        </a>
      );
    })}
  </div>
  {month !== today.slice(0, 7) && (
    <a href={`${here}?month=${today.slice(0, 7)}`} class="mt-2 block rounded-lg px-2 py-1 text-center text-sm text-muted hover:bg-hover hover:text-ink">This month</a>
  )}
</nav>
