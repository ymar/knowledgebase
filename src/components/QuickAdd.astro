---
/**
 * "+ Type" buttons under a daily note's date, like the calendar quick actions in
 * Capacities: create an object with its daily-note date property set to this day.
 * Only types that are on and have a date property chosen under "Daily notes" in the
 * type editor. The new object appears under Date references; you stay on the day.
 */
import Icon from './Icon.astro';
import TypeTile from './TypeTile.astro';
import type { TypeRow } from '../lib/schema';
import { isTaskType } from '../lib/db/tasks';

interface Props { types: TypeRow[]; date: string; workspaceId: string }
const { date, workspaceId } = Astro.props;
const types = Astro.props.types.filter((t) => t.enabled && t.day_key && t.id !== 'type_day' && t.id !== 'type_tag');
const labelOf = (t: TypeRow) => t.properties.find((p) => p.key === t.day_key)?.label ?? 'Date';
---
{types.length > 0 ? (
  <div data-quick-add data-date={date} data-ws={workspaceId} class="mt-4">
    <div class="flex flex-wrap gap-2" role="group" aria-label="Add to this day">
      {types.map((t) => (
        <button type="button" data-qa-type={t.id} data-qa-name={t.name} data-qa-label={labelOf(t)} data-qa-task={isTaskType(t.id) ? 'true' : undefined}
          title={`New ${t.name.toLowerCase()} with ${labelOf(t)} on this day`}
          class="inline-flex items-center gap-1.5 rounded-lg border border-line bg-card py-1 pl-2 pr-2.5 text-sm text-ink/80 shadow-xs transition hover:border-ink/25 hover:text-ink aria-pressed:border-ink/40 aria-pressed:text-ink">
          <Icon name="plus" size={13} class="text-muted" />
          <TypeTile icon={t.icon} color={t.color} size="sm" />
          {t.name}
        </button>
      ))}
    </div>
    <form data-qa-form hidden class="mt-2 flex gap-2">
      <input data-qa-input required autocomplete="off" class="field flex-1" aria-label="Name" />
      <button class="btn-primary" type="submit">Add</button>
      <button class="btn" type="button" data-qa-cancel>Cancel</button>
    </form>
    <p data-qa-status class="mt-1.5 text-sm text-muted" aria-live="polite"></p>
  </div>
) : (
  <p class="mt-3 text-sm text-muted">
    Want buttons here? In <a href="/types" class="underline underline-offset-2 hover:text-ink">Types</a>, give a type a date property and pick it under “Daily notes”.
  </p>
)}

<script>
  document.querySelectorAll<HTMLElement>('[data-quick-add]').forEach((root) => {
    const form = root.querySelector<HTMLFormElement>('[data-qa-form]')!;
    const input = root.querySelector<HTMLInputElement>('[data-qa-input]')!;
    const status = root.querySelector<HTMLElement>('[data-qa-status]')!;
    const chips = [...root.querySelectorAll<HTMLButtonElement>('[data-qa-type]')];
    let chip: HTMLButtonElement | null = null;

    const close = () => {
      form.hidden = true;
      chips.forEach((c) => c.removeAttribute('aria-pressed'));
      chip?.focus();
    };
    chips.forEach((c) =>
      c.addEventListener('click', () => {
        if (chip === c && !form.hidden) return close();
        chip = c;
        chips.forEach((x) => x.toggleAttribute('aria-pressed', x === c));
        input.placeholder = `New ${c.dataset.qaName!.toLowerCase()}…`;
        input.value = '';
        status.textContent = '';
        form.hidden = false;
        input.focus();
      }),
    );
    root.querySelector('[data-qa-cancel]')!.addEventListener('click', close);
    input.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        e.preventDefault();
        close();
      }
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const title = input.value.trim();
      if (!title || !chip) return;
      const res = await fetch('/api/objects', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ typeId: chip.dataset.qaType, title, workspaceId: root.dataset.ws, date: root.dataset.date }),
      });
      if (!res.ok) {
        status.textContent = 'Could not add it. Try again.';
        return;
      }
      const s = (await res.json()) as { id: string; title: string; type_name: string; type_icon: string; type_color: string };

      // Tasks go into the day's task list, ready to tick.
      if (chip.dataset.qaTask) {
        const list = document.querySelector<HTMLElement>('[data-task-list=planned]');
        if (list) {
          const li = document.createElement('li');
          li.className = 'flex items-center gap-3 px-3.5 py-2.5';
          li.dataset.task = s.id;
          li.dataset.done = 'false';
          const box = document.createElement('button');
          box.type = 'button';
          box.dataset.toggle = '';
          box.setAttribute('role', 'checkbox');
          box.setAttribute('aria-checked', 'false');
          box.setAttribute('aria-label', `Done: ${s.title}`);
          box.className = 'task-box flex h-5 w-5 shrink-0 items-center justify-center rounded-md border border-ink/30 text-primary-ink transition aria-checked:border-primary aria-checked:bg-primary';
          box.innerHTML = '<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="check"><path d="M20 6 9 17l-5-5"/></svg>';
          const a = document.createElement('a');
          a.href = `/o/${s.id}`;
          a.className = 'min-w-0 flex-1 truncate text-[15px] hover:underline';
          a.dataset.title = '';
          a.textContent = s.title;
          li.appendChild(box);
          li.appendChild(a);
          list.appendChild(li);
          list.closest('[data-group]')?.classList.remove('hidden');
          list.closest('[data-tasks]')?.classList.remove('hidden');
        }
      }

      // Everything else shows under Date references right away (main column and side panel).
      const tile = chip.querySelector('.tile')!.cloneNode(true);
      if (!chip.dataset.qaTask) document.querySelectorAll<HTMLElement>('[data-date-refs]').forEach((list) => {
        const li = document.createElement('li');
        const a = document.createElement('a');
        a.href = `/o/${s.id}`;
        a.className = 'flex items-center gap-3 px-3.5 py-2.5 transition-colors hover:bg-hover';
        const text = document.createElement('span');
        text.className = 'min-w-0 flex-1';
        const name = document.createElement('span');
        name.className = 'block truncate text-[15px]';
        name.textContent = s.title;
        const meta = document.createElement('span');
        meta.className = 'block text-xs text-muted';
        meta.textContent = `${s.type_name} · ${chip!.dataset.qaLabel}`;
        text.appendChild(name);
        text.appendChild(meta);
        a.appendChild(tile.cloneNode(true));
        a.appendChild(text);
        li.appendChild(a);
        list.appendChild(li);
        list.closest('[data-date-refs-section]')?.classList.remove('hidden');
      });

      status.textContent = '';
      const link = document.createElement('a');
      link.href = `/o/${s.id}`;
      link.className = 'font-medium text-ink underline underline-offset-2';
      link.textContent = s.title;
      status.appendChild(document.createTextNode('Added '));
      status.appendChild(link);
      status.appendChild(document.createTextNode(' to this day.'));
      close();
    });
  });
</script>
