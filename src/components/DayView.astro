---
import Editor from './react/Editor';
import Backlinks from './Backlinks.astro';
import ObjectList from './ObjectList.astro';
import Icon from './Icon.astro';
import DatePicker from './DatePicker.astro';
import QuickAdd from './QuickAdd.astro';
import DateRefs from './DateRefs.astro';
import MonthCalendar from './MonthCalendar.astro';
import TaskList from './TaskList.astro';
import { activityOn, dateReferences, daysWithNotes, findDay, getObject, getTypeById, isTaskType, listTypes, markOpened, scheduledCounts, tasksForDay } from '../lib/db';
import { editorProps } from '../lib/editor-props';
import { addDays, dayLabel } from '../lib/format';

interface Props { date: string; today: string }
const { date, today } = Astro.props;

// Week strip: Monday..Sunday around `date`.
const dow = (new Date(`${date}T00:00:00Z`).getUTCDay() + 6) % 7;
const monday = addDays(date, -dow);
const week = Array.from({ length: 7 }, (_, i) => addDays(monday, i));

const ws = Astro.locals.workspace.id;
const dayId = await findDay(ws, date);
if (dayId) {
  const opened = markOpened(dayId);
  if (Astro.locals.cfContext?.waitUntil) Astro.locals.cfContext.waitUntil(opened);
  else await opened;
}
// Month calendar: ?month=YYYY-MM, else the month of `date`. Six Monday-first weeks.
const monthParam = Astro.url.searchParams.get('month') ?? '';
const month = /^\d{4}-(0[1-9]|1[0-2])$/.test(monthParam) ? monthParam : date.slice(0, 7);
const first = `${month}-01`;
const gridStart = addDays(first, -((new Date(`${first}T00:00:00Z`).getUTCDay() + 6) % 7));
const gridEnd = addDays(gridStart, 41);
const rangeFrom = gridStart < week[0] ? gridStart : week[0];
const rangeTo = gridEnd > week[6] ? gridEnd : week[6];

const [day, withNotes, activity, refsOnDay, scheduled, allTypes, tasks] = await Promise.all([
  dayId ? getObject(dayId) : null,
  daysWithNotes(ws, rangeFrom, rangeTo),
  activityOn(ws, date),
  dateReferences(ws, date),
  scheduledCounts(ws, gridStart, gridEnd),
  listTypes(ws, { includeDisabled: true }),
  tasksForDay(ws, date, today),
]);
const propLabel = (typeId: string, key: string) =>
  allTypes.find((t) => t.id === typeId)?.properties.find((p) => p.key === key)?.label ?? 'Date';
// Tasks have their own list; Date references shows everything else scheduled on the day.
const dateRefItems = refsOnDay.filter((r) => !isTaskType(r.type_id)).map((r) => ({ ...r, label: propLabel(r.type_id, r.day_key) }));
const taskTypeId = allTypes.find((t) => isTaskType(t.id) && t.enabled)?.id ?? null;
// No day object yet: show the Day template. The object is created on first save.
const initial = day ? day.content : ((await getTypeById('type_day'))?.template ?? []);
const { refs, types } = await editorProps(ws, initial);
const quickTypes = allTypes;
const fmt = (iso: string, opt: Intl.DateTimeFormatOptions) =>
  new Intl.DateTimeFormat('en-GB', { ...opt, timeZone: 'UTC' }).format(new Date(`${iso}T00:00:00Z`));
---
<div class="xl:grid xl:grid-cols-[minmax(0,1fr)_17rem] xl:gap-12">
<div class="min-w-0">
<div class="flex flex-wrap items-center justify-between gap-3">
  <p class="eyebrow">{date === today ? 'Today' : date < today ? 'Past day' : 'Upcoming'}</p>
  <div class="flex items-center gap-1.5">
    <a href={`/day/${addDays(date, -1)}`} class="btn px-2" aria-label="Previous day" title="Previous day ( [ )"><Icon name="chevron-left" size={16} /></a>
    {date !== today && <a href="/" class="btn" title="Today (t)">Today</a>}
    <a href={`/day/${addDays(date, 1)}`} class="btn px-2" aria-label="Next day" title="Next day ( ] )"><Icon name="chevron-right" size={16} /></a>
    <DatePicker mode="navigate" value={date} today={today} label="Go to date" align="right" class="ml-1" />
  </div>
</div>

<h1 class="mt-3 text-3xl font-bold tracking-tight md:text-[2.5rem] md:leading-tight">{dayLabel(date)}</h1>

<QuickAdd types={quickTypes} date={date} workspaceId={ws} />

<nav aria-label="This week" class="mt-5 grid grid-cols-7 xl:hidden gap-1 rounded-xl border border-line bg-card p-1.5">
  {week.map((d) => (
    <a href={d === today ? '/' : `/day/${d}`} aria-current={d === date ? 'date' : undefined}
      class:list={[
        'flex flex-col items-center rounded-lg py-1.5 text-xs transition-colors',
        d === date ? 'bg-primary text-primary-ink' : 'hover:bg-hover',
        d === today && d !== date && 'font-semibold text-ink',
        d !== today && d !== date && 'text-muted',
      ]}>
      <span>{fmt(d, { weekday: 'narrow' })}</span>
      <span class="text-[15px] font-medium tabular-nums">{fmt(d, { day: 'numeric' })}</span>
      <span class:list={['mt-0.5 h-1 w-1 rounded-full', withNotes.has(d) ? (d === date ? 'bg-primary-ink' : 'bg-ink/50') : 'bg-transparent']}></span>
    </a>
  ))}
</nav>

<TaskList planned={tasks.planned} due={tasks.due} today={today} />

<div class="mt-8">
  <Editor client:only="react" saveUrl={`/api/days/${date}/content?ws=${ws}`} workspaceId={ws} taskTypeId={taskTypeId} dayDate={date} initialContent={initial} refs={refs} types={types} selfId={dayId} />
</div>

<DateRefs items={dateRefItems} class="mt-12 xl:hidden" />

{activity.length > 0 && (
  <section class="mt-14" aria-labelledby="activity-h">
    <h2 id="activity-h" class="eyebrow mb-3">Created or edited this day</h2>
    <ObjectList items={activity} />
  </section>
)}

{day && <Backlinks targetId={day.id} targetTitle={day.title} />}
</div>

<aside class="hidden xl:block" aria-label="Calendar and date references">
  <div class="sticky top-14 space-y-8">
    <MonthCalendar date={date} today={today} month={month} gridStart={gridStart} noteDays={withNotes} scheduled={scheduled} />
    <DateRefs items={dateRefItems} />
  </div>
</aside>
</div>

<script is:inline define:vars={{ prev: `/day/${addDays(date, -1)}`, next: `/day/${addDays(date, 1)}` }}>
  addEventListener('keydown', (e) => {
    if (e.metaKey || e.ctrlKey || e.altKey) return;
    const t = e.target;
    if (t instanceof HTMLElement && (t.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(t.tagName))) return;
    if (e.key === '[') location.href = prev;
    else if (e.key === ']') location.href = next;
    else if (e.key === 't') location.href = '/';
  });
</script>
