---
import type { ObjectCard, PropertyDef } from '../lib/schema';
import TypeTile from './TypeTile.astro';
import { displayValue } from '../lib/property-display';
import { dayLabel, shortDate } from '../lib/format';

interface Props {
  /** `lines`: matching blocks to show under the result (query "Show matching blocks"). */
  items: (ObjectCard & { lines?: string[] })[];
  defs: PropertyDef[];
  /** 'board' is rendered by TypeBoard; here it falls back to the list. */
  view: 'list' | 'cards' | 'table' | 'board';
  relTitles: Record<string, string>;
  empty: string;
}
const { items, defs, view, relTitles, empty } = Astro.props;
const shown = (o: ObjectCard, max: number) =>
  defs
    .map((d) => ({ d, text: displayValue(d, o.properties[d.key], relTitles) }))
    .filter((x) => x.text)
    .slice(0, max);
const title = (o: ObjectCard) => (o.type_id === 'type_day' ? dayLabel(o.title) : o.title || 'Untitled');
---
{items.length === 0 ? (
  <p class="rounded-xl border border-dashed border-line px-6 py-10 text-center text-sm text-muted">{empty}</p>
) : view === 'table' ? (
  <div class="overflow-x-auto rounded-xl border border-line bg-card">
    <table class="w-full min-w-[36rem] border-collapse text-sm">
      <thead>
        <tr class="border-b border-line text-left text-xs font-medium text-muted">
          <th scope="col" class="px-4 py-2.5 font-medium">Title</th>
          {defs.map((d) => <th scope="col" class="whitespace-nowrap px-3 py-2.5 font-medium">{d.label}</th>)}
          <th scope="col" class="whitespace-nowrap px-4 py-2.5 text-right font-medium">Edited</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-line">
        {items.map((o) => (
          <tr data-select={o.id} class="hover:bg-hover">
            <th scope="row" class="max-w-[18rem] px-4 py-2.5 text-left font-normal">
              <a href={`/o/${o.id}`} class="flex items-center gap-2.5 hover:underline">
                <TypeTile icon={o.type_icon} color={o.type_color} size="sm" emoji={o.icon} />
                <span class="truncate text-[15px]">{title(o)}</span>
              </a>
            </th>
            {defs.map((d) => <td class="max-w-[14rem] truncate px-3 py-2.5 text-muted" title={displayValue(d, o.properties[d.key], relTitles)}>{displayValue(d, o.properties[d.key], relTitles)}</td>)}
            <td class="whitespace-nowrap px-4 py-2.5 text-right text-xs tabular-nums text-muted">{shortDate(o.updated_at)}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
) : view === 'cards' ? (
  <ul class="grid gap-3 sm:grid-cols-2">
    {items.map((o) => (
      <li data-select={o.id}>
        <a href={`/o/${o.id}`} class="card flex h-full flex-col p-4">
          <span class="flex items-center gap-2.5">
            <TypeTile icon={o.type_icon} color={o.type_color} size="sm" emoji={o.icon} />
            <span class="truncate font-semibold">{title(o)}</span>
          </span>
          {shown(o, 3).length > 0 && (
            <span class="mt-2.5 flex flex-wrap gap-1.5">
              {shown(o, 3).map(({ d, text }) => (
                <span class="rounded-md bg-panel px-1.5 py-0.5 text-xs text-muted" title={d.label}>{text}</span>
              ))}
            </span>
          )}
          {o.lines?.length ? (
            <span class="mt-2.5 space-y-1.5">
              {o.lines.map((l) => <span class="block border-l-2 border-line pl-2.5 text-sm leading-relaxed text-ink/80">{l}</span>)}
            </span>
          ) : o.excerpt && <span class="mt-2.5 line-clamp-3 text-sm leading-relaxed text-ink/70">{o.excerpt}</span>}
          <span class="mt-auto pt-3 text-xs text-muted">{shortDate(o.updated_at)}</span>
        </a>
      </li>
    ))}
  </ul>
) : (
  <ul class="divide-y divide-line overflow-hidden rounded-xl border border-line bg-card">
    {items.map((o) => (
      <li data-select={o.id}>
        <a href={`/o/${o.id}`} class="flex items-center gap-3 px-4 py-3 transition-colors hover:bg-hover">
          <TypeTile icon={o.type_icon} color={o.type_color} size="sm" emoji={o.icon} />
          <span class="min-w-0 flex-1 truncate text-[15px]">{title(o)}</span>
          {shown(o, 2).map(({ d, text }) => (
            <span class="hidden max-w-[10rem] truncate rounded-md bg-panel px-1.5 py-0.5 text-xs text-muted sm:inline" title={d.label}>{text}</span>
          ))}
          <span class="w-14 text-right text-xs tabular-nums text-muted">{shortDate(o.updated_at)}</span>
        </a>
        {o.lines && o.lines.length > 0 && (
          <ul class="space-y-1.5 px-4 pb-3 pl-[3.25rem]" aria-label="Matching blocks">
            {o.lines.map((l) => <li class="border-l-2 border-line pl-2.5 text-sm leading-relaxed text-ink/80">{l}</li>)}
          </ul>
        )}
      </li>
    ))}
  </ul>
)}
