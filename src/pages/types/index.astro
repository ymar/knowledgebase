---
import Base from '../../layouts/Base.astro';
import TypeTile from '../../components/TypeTile.astro';
import Icon from '../../components/Icon.astro';
import { countByType, isSystemType, listTypes } from '../../lib/db';

const ws = Astro.locals.workspace;
const [types, counts] = await Promise.all([listTypes(ws.id, { includeDisabled: true }), countByType(ws.id)]);
const on = types.filter((t) => t.enabled);
const off = types.filter((t) => !t.enabled);
const error = Astro.url.searchParams.get('error');
---
<Base title="Types">
  <h1 class="text-3xl font-bold tracking-tight md:text-4xl">Types</h1>
  <p class="mt-2 text-muted">
    The kinds of objects in <span class="inline-flex items-center gap-1.5 font-medium text-ink"><span class="h-2 w-2 rounded-full" style={`background:${ws.color}`}></span>{ws.name}</span>.
    Each workspace has its own types. Day and Tag are shared and always on.
  </p>

  <form method="post" action="/api/types" class="mt-8 flex gap-2">
    <input name="name" required autocomplete="off" placeholder="New type, e.g. Recipe" aria-label="New type name" class="field flex-1" data-new-object />
    <button class="btn-primary" type="submit"><Icon name="plus" size={16} /> <span class="hidden sm:inline">Create type</span></button>
  </form>
  {error && <p role="alert" class="mt-2 text-sm text-red-600">{error}</p>}

  {[['On', on], ['Turned off', off]].map(([label, list]) => (list as typeof types).length > 0 && (
    <section class="mt-8">
      <h2 class="eyebrow mb-3">{label as string}</h2>
      <ul class="divide-y divide-line overflow-hidden rounded-xl border border-line bg-card">
        {(list as typeof types).map((t) => (
          <li class="flex items-center gap-3 px-4 py-3">
            <a href={`/types/${t.id}`} class="flex min-w-0 flex-1 items-center gap-3 hover:underline">
              <span class:list={[!t.enabled && 'opacity-50']}><TypeTile icon={t.icon} color={t.color} /></span>
              <span class="min-w-0 flex-1">
                <span class="block font-medium">{t.name}</span>
                <span class="block truncate text-xs text-muted">
                  {t.properties.length ? t.properties.map((p) => p.label).join(' · ') : 'No properties'}
                </span>
              </span>
            </a>
            <span class="text-xs tabular-nums text-muted">{counts[t.id] ?? 0}</span>
            {isSystemType(t) ? (
              <span class="w-[4.5rem] text-right text-xs text-muted">Always on</span>
            ) : (
              <form method="post" action={`/api/types/${t.id}`}>
                <input type="hidden" name="_action" value={t.enabled ? 'disable' : 'enable'} />
                <button type="submit" role="switch" aria-checked={t.enabled ? 'true' : 'false'} aria-label={`${t.name} ${t.enabled ? 'on' : 'off'}`}
                  class="relative h-6 w-10 rounded-full bg-line transition aria-checked:bg-primary">
                  <span class:list={['absolute top-0.5 h-5 w-5 rounded-full bg-card shadow-sm transition-all', t.enabled ? 'left-[1.125rem]' : 'left-0.5']}></span>
                </button>
              </form>
            )}
          </li>
        ))}
      </ul>
    </section>
  ))}
  {off.length > 0 && <p class="mt-2 text-xs text-muted">Objects of a turned-off type stay in search, links and backlinks.</p>}
</Base>
