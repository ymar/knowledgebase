---
import Base from '../layouts/Base.astro';
import ObjectList from '../components/ObjectList.astro';
import { listRecent } from '../lib/db';
const recent = await listRecent(15);
---
<Base>
  <h1 class="font-serif text-4xl font-semibold">Cairn</h1>
  <p class="mt-2 text-muted">Everything you've piled up, most recent first.</p>
  <h2 class="mb-3 mt-10 text-xs font-semibold uppercase tracking-wide text-muted">Recent</h2>
  <ObjectList items={recent} showType />
</Base>
