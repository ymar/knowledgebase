---
import Base from '../../layouts/Base.astro';
import PropertyForm from '../../components/PropertyForm.astro';
import TypeTile from '../../components/TypeTile.astro';
import Icon from '../../components/Icon.astro';
import Backlinks from '../../components/Backlinks.astro';
import Editor from '../../components/react/Editor';
import { getObject, getTypeById, getTypeBySlug, listObjectsByType } from '../../lib/db';
import { editorProps } from '../../lib/editor-props';
import type { ObjectSummary } from '../../lib/schema';

const object = await getObject(Astro.params.id!);
if (!object) return new Response('Not found', { status: 404 });
if (object.type_id === 'type_day') return Astro.redirect(`/day/${object.title}`, 302);
const type = (await getTypeById(object.type_id))!;

const relationOptions: Record<string, ObjectSummary[]> = {};
for (const d of type.properties) {
  if (d.kind !== 'relation' || !d.target) continue;
  const target = await getTypeBySlug(d.target);
  if (target) relationOptions[d.key] = await listObjectsByType(target.id, 200);
}
const { refs, types } = await editorProps(object.content);
const hasTemplate = type.template.length > 0;
---
<Base title={object.title || 'Untitled'} activeTypeId={type.id}>
  <a href={`/t/${type.slug}`} class="inline-flex items-center gap-2 rounded-lg py-1 pr-2 text-sm font-medium text-muted hover:text-ink">
    <TypeTile icon={type.icon} color={type.color} size="sm" /> {type.name}
  </a>

  <form method="post" action={`/api/objects/${object.id}`} class="mt-3">
    <input type="hidden" name="_action" value="rename" />
    <input
      name="title" value={object.title} placeholder="Untitled" aria-label="Title" autocomplete="off"
      class="w-full bg-transparent text-3xl font-bold tracking-tight placeholder:text-muted/60 focus:outline-none md:text-[2.5rem] md:leading-tight"
      onchange="this.form.requestSubmit()"
    />
  </form>

  {type.properties.length > 0 && (
    <div class="mt-6">
      <PropertyForm object={object} defs={type.properties} relationOptions={relationOptions} />
    </div>
  )}

  <div class="mt-8">
    <Editor client:only="react" saveUrl={`/api/objects/${object.id}/content`} initialContent={object.content} refs={refs} types={types} selfId={object.id} />
  </div>

  <Backlinks targetId={object.id} targetTitle={object.title} />

  <div class="mt-14 flex flex-wrap items-center justify-end gap-1 border-t border-line pt-4 text-sm">
    <form method="post" action={`/api/objects/${object.id}`}>
      <input type="hidden" name="_action" value="template" />
      <button class="rounded-lg px-2 py-1.5 text-muted hover:bg-hover hover:text-ink" type="submit"
        title={`New ${type.name.toLowerCase()} objects will start with this document`}>
        <span class="inline-flex items-center gap-1.5"><Icon name="layout" size={15} /> Use as {type.name.toLowerCase()} template</span>
      </button>
    </form>
    {hasTemplate && (
      <form method="post" action={`/api/objects/${object.id}`}>
        <input type="hidden" name="_action" value="clear-template" />
        <button class="rounded-lg px-2 py-1.5 text-muted hover:bg-hover hover:text-ink" type="submit">Clear template</button>
      </form>
    )}
    <form method="post" action={`/api/objects/${object.id}`}
      onsubmit="return confirm('Delete this object? It stays in the database but disappears from the app.')">
      <input type="hidden" name="_action" value="delete" />
      <button class="inline-flex items-center gap-1.5 rounded-lg px-2 py-1.5 text-muted hover:bg-hover hover:text-red-600" type="submit">
        <Icon name="trash" size={15} /> Delete
      </button>
    </form>
  </div>
</Base>
