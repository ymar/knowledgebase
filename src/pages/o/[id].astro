---
import Base from '../../layouts/Base.astro';
import PropertyForm from '../../components/PropertyForm.astro';
import TypeTile from '../../components/TypeTile.astro';
import Icon from '../../components/Icon.astro';
import { getObject, getTypeById, getTypeBySlug, listObjectsByType } from '../../lib/db';
import type { ObjectSummary } from '../../lib/schema';
import { dayLabel } from '../../lib/format';

const object = await getObject(Astro.params.id!);
if (!object) return new Response('Not found', { status: 404 });
const type = (await getTypeById(object.type_id))!;

const relationOptions: Record<string, ObjectSummary[]> = {};
for (const d of type.properties) {
  if (d.kind !== 'relation' || !d.target) continue;
  const target = await getTypeBySlug(d.target);
  if (target) relationOptions[d.key] = await listObjectsByType(target.id, 200);
}
const isDay = type.id === 'type_day';
---
<Base title={isDay ? dayLabel(object.title) : object.title || 'Untitled'} activeTypeId={type.id}>
  <a href={`/t/${type.slug}`} class="inline-flex items-center gap-2 rounded-lg py-1 pr-2 text-sm font-medium text-muted hover:text-ink">
    <TypeTile icon={type.icon} color={type.color} size="sm" /> {type.name}
  </a>

  {isDay ? (
    <h1 class="mt-3 text-3xl font-bold tracking-tight md:text-[2.5rem] md:leading-tight">{dayLabel(object.title)}</h1>
  ) : (
    <form method="post" action={`/api/objects/${object.id}`} class="mt-3">
      <input type="hidden" name="_action" value="rename" />
      <input
        name="title" value={object.title} placeholder="Untitled" aria-label="Title" autocomplete="off"
        class="w-full bg-transparent text-3xl font-bold tracking-tight placeholder:text-muted/60 focus:outline-none md:text-[2.5rem] md:leading-tight"
        onchange="this.form.requestSubmit()"
      />
    </form>
  )}

  <div class="mt-6">
    <PropertyForm object={object} defs={type.properties} relationOptions={relationOptions} />
  </div>

  <section class="mt-8 rounded-xl border border-dashed border-line px-6 py-12 text-center text-sm text-muted">
    The editor arrives in phase 2.
  </section>

  <form method="post" action={`/api/objects/${object.id}`} class="mt-12 flex justify-end"
    onsubmit="return confirm('Delete this object? It stays in the database but disappears from the app.')">
    <input type="hidden" name="_action" value="delete" />
    <button class="inline-flex items-center gap-1.5 rounded-lg px-2 py-1.5 text-sm text-muted hover:bg-hover hover:text-red-600" type="submit">
      <Icon name="trash" size={15} /> Delete
    </button>
  </form>
</Base>
