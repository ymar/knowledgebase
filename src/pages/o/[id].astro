---
import Base from '../../layouts/Base.astro';
import PropertyForm from '../../components/PropertyForm.astro';
import TypeTile from '../../components/TypeTile.astro';
import Icon from '../../components/Icon.astro';
import Backlinks from '../../components/Backlinks.astro';
import TaggedList from '../../components/TaggedList.astro';
import Snippet from '../../components/Snippet.astro';
import Editor from '../../components/react/Editor';
import {
  allTags, getTypeById, getTypeBySlug, getObject, listObjectsByType, listTypes, markOpened, pickedTags,
} from '../../lib/db';
import { editorProps } from '../../lib/editor-props';
import { unlinkedMentions } from '../../lib/unlinked';
import type { ObjectSummary } from '../../lib/schema';

const object = await getObject(Astro.params.id!);
if (!object) return new Response('Not found', { status: 404 });
if (object.type_id === 'type_day') return Astro.redirect(`/day/${object.title}`, 302);

// Record the view off the critical path.
const opened = markOpened(object.id);
if (Astro.locals.cfContext?.waitUntil) Astro.locals.cfContext.waitUntil(opened);
else await opened;

const type = (await getTypeById(object.type_id))!;
const isTag = type.id === 'type_tag';

const relationOptions: Record<string, ObjectSummary[]> = {};
for (const d of type.properties) {
  if (d.kind !== 'relation' || !d.target) continue;
  const target = await getTypeBySlug(d.target);
  if (target) relationOptions[d.key] = await listObjectsByType(target.id, 200);
}
const [{ refs, types }, allTypes, tags, tagOptions, unlinked] = await Promise.all([
  editorProps(object.content),
  listTypes(),
  isTag ? Promise.resolve([]) : pickedTags(object.id),
  allTags(),
  unlinkedMentions(object),
]);
const hasTemplate = type.template.length > 0;

// For each target type, which filled-in properties would be dropped.
const filled = type.properties.filter((d) => object.properties[d.key] !== null && object.properties[d.key] !== undefined && object.properties[d.key] !== '');
const moveTargets = allTypes
  .filter((t) => t.id !== type.id && t.id !== 'type_day')
  .map((t) => ({ t, dropped: filled.filter((d) => !t.properties.some((p) => p.key === d.key)).map((d) => d.label) }));
const pinned = object.pinned_at !== null;
const notice = Astro.url.searchParams.get('notice');
---
<Base title={object.title || 'Untitled'} activeTypeId={type.id} activeObjectId={object.id}>
  <div class="flex items-center justify-between gap-3">
    <details class="relative" id="type-menu">
      <summary class="inline-flex cursor-pointer list-none items-center gap-2 rounded-lg py-1 pr-2 text-sm font-medium text-muted hover:text-ink"
        title="Change type">
        <TypeTile icon={type.icon} color={type.color} size="sm" /> {type.name} <span aria-hidden="true" class="text-xs">⌄</span>
      </summary>
      <div class="absolute left-0 z-20 mt-1 w-60 rounded-xl border border-line bg-card p-1.5 shadow-lg">
        <a href={`/t/${type.slug}`} class="block rounded-lg px-2.5 py-1.5 text-sm hover:bg-hover">Open {type.name} list</a>
        <p class="eyebrow px-2.5 pb-1 pt-2.5">Change type to</p>
        {moveTargets.map(({ t, dropped }) => (
          <form method="post" action={`/api/objects/${object.id}`}
            data-confirm={dropped.length ? `Change to ${t.name}? These properties will be removed: ${dropped.join(', ')}.` : ''}
            onsubmit="return !this.dataset.confirm || confirm(this.dataset.confirm)">
            <input type="hidden" name="_action" value="change-type" />
            <input type="hidden" name="typeId" value={t.id} />
            <button type="submit" class="flex w-full items-center gap-2.5 rounded-lg px-2.5 py-1.5 text-left text-sm hover:bg-hover">
              <TypeTile icon={t.icon} color={t.color} size="sm" /> {t.name}
              {dropped.length > 0 && <span class="ml-auto text-[11px] text-muted">−{dropped.length}</span>}
            </button>
          </form>
        ))}
      </div>
    </details>

    <form method="post" action={`/api/objects/${object.id}`}>
      <input type="hidden" name="_action" value={pinned ? 'unpin' : 'pin'} />
      <button type="submit" aria-pressed={pinned ? 'true' : 'false'}
        class="-mr-2 inline-flex items-center gap-1.5 rounded-lg px-2 py-1 text-sm text-muted hover:bg-hover hover:text-ink aria-pressed:text-ink">
        <Icon name="pin" size={15} /> {pinned ? 'Pinned' : 'Pin'}
      </button>
    </form>
  </div>

  {notice && <p role="status" class="mt-3 rounded-lg border border-line bg-card px-3 py-2 text-sm text-muted">{notice}</p>}

  <form method="post" action={`/api/objects/${object.id}`} class="mt-3">
    <input type="hidden" name="_action" value="rename" />
    <input
      name="title" value={object.title} placeholder="Untitled" aria-label="Title" autocomplete="off"
      class="w-full bg-transparent text-3xl font-bold tracking-tight placeholder:text-muted/60 focus:outline-none md:text-[2.5rem] md:leading-tight"
      onchange="this.form.requestSubmit()"
    />
  </form>

  {!isTag && (
    <div class="mt-3 flex flex-wrap items-center gap-1.5">
      {tags.map((t) => (
        <form method="post" action={`/api/objects/${object.id}`} class="contents">
          <input type="hidden" name="_action" value="remove-tag" />
          <input type="hidden" name="tagId" value={t.id} />
          <span class="mention mention-tag" style={`--c:${t.type_color}`}>
            <a href={`/o/${t.id}`} class="hover:underline">#{t.title}</a>
            <button type="submit" aria-label={`Remove tag ${t.title}`} class="ml-0.5 rounded text-muted hover:text-ink"><Icon name="x" size={12} /></button>
          </span>
        </form>
      ))}
      <form method="post" action={`/api/objects/${object.id}`} class="inline-flex">
        <input type="hidden" name="_action" value="add-tag" />
        <label class="sr-only" for="add-tag">Add tag</label>
        <input id="add-tag" name="tag" list="tag-options" placeholder="+ Add tag" autocomplete="off"
          class="-ml-1.5 w-32 rounded-md bg-transparent px-1.5 py-0.5 text-sm text-muted placeholder:text-muted focus:bg-card focus:text-ink focus:outline-none focus:ring-1 focus:ring-line" />
        <datalist id="tag-options">{tagOptions.map((t) => <option value={t.title} />)}</datalist>
      </form>
    </div>
  )}

  {type.properties.length > 0 && (
    <div class="mt-6">
      <PropertyForm object={object} defs={type.properties} relationOptions={relationOptions} />
    </div>
  )}

  {isTag && <TaggedList tagId={object.id} tagTitle={object.title} />}

  {isTag && tagOptions.length > 1 && (
    <form method="post" action={`/api/objects/${object.id}`} class="mt-4 flex flex-wrap items-center gap-2 text-sm"
      onsubmit={`return confirm('Merge #${object.title.replace(/'/g, '')} into the chosen tag? Everything tagged moves over and this tag goes to the trash.')`}>
      <input type="hidden" name="_action" value="merge-tag" />
      <label for="merge-into" class="text-muted"><span class="inline-flex items-center gap-1.5"><Icon name="merge" size={15} /> Merge into</span></label>
      <select id="merge-into" name="into" class="field w-auto py-1.5">
        {tagOptions.filter((t) => t.id !== object.id).map((t) => <option value={t.id}>#{t.title}</option>)}
      </select>
      <button class="btn py-1.5" type="submit">Merge</button>
    </form>
  )}

  <div class="mt-8">
    <Editor client:only="react" saveUrl={`/api/objects/${object.id}/content`} initialContent={object.content} refs={refs} types={types} selfId={object.id} />
  </div>

  {!isTag && <Backlinks targetId={object.id} targetTitle={object.title} />}

  {unlinked.length > 0 && (
    <section aria-labelledby="unlinked-h" class="mt-10">
      <h2 id="unlinked-h" class="eyebrow mb-3">Unlinked mentions <span class="ml-1 tabular-nums">{unlinked.length}</span></h2>
      <ul class="space-y-2">
        {unlinked.map((u) => (
          <li class="flex items-start gap-3 rounded-xl border border-dashed border-line p-3.5">
            <TypeTile icon={u.type_icon} color={u.type_color} size="sm" />
            <div class="min-w-0 flex-1">
              <a href={`/o/${u.id}`} class="font-medium hover:underline">{u.title || 'Untitled'}</a>
              <p class="mt-0.5 line-clamp-2 text-sm text-ink/70"><Snippet text={u.snippet} /></p>
            </div>
            <form method="post" action={`/api/objects/${object.id}`}>
              <input type="hidden" name="_action" value="link-mention" />
              <input type="hidden" name="source" value={u.id} />
              <button class="btn px-2.5 py-1" type="submit"><Icon name="link" size={14} /> Link</button>
            </form>
          </li>
        ))}
      </ul>
    </section>
  )}

  <div class="mt-14 flex flex-wrap items-center justify-end gap-1 border-t border-line pt-4 text-sm">
    <form method="post" action={`/api/objects/${object.id}`}>
      <input type="hidden" name="_action" value="template" />
      <button class="rounded-lg px-2 py-1.5 text-muted hover:bg-hover hover:text-ink" type="submit"
        title={`New ${type.name.toLowerCase()} objects will start with this document`}>
        <span class="inline-flex items-center gap-1.5"><Icon name="layout" size={15} /> Use as {type.name.toLowerCase()} template</span>
      </button>
    </form>
    {hasTemplate && (
      <form method="post" action={`/api/objects/${object.id}`}>
        <input type="hidden" name="_action" value="clear-template" />
        <button class="rounded-lg px-2 py-1.5 text-muted hover:bg-hover hover:text-ink" type="submit">Clear template</button>
      </form>
    )}
    <form method="post" action={`/api/objects/${object.id}`} class="-mr-2"
      onsubmit="return confirm('Delete this object? It stays in the database but disappears from the app.')">
      <input type="hidden" name="_action" value="delete" />
      <button class="inline-flex items-center gap-1.5 rounded-lg px-2 py-1.5 text-muted hover:bg-hover hover:text-red-600" type="submit">
        <Icon name="trash" size={15} /> Delete
      </button>
    </form>
  </div>

  <script is:inline>
    // Close the type menu on Escape or an outside click.
    const menu = document.getElementById('type-menu');
    addEventListener('keydown', (e) => { if (e.key === 'Escape') menu.open = false; });
    addEventListener('click', (e) => { if (!menu.contains(e.target)) menu.open = false; });
  </script>
</Base>
