---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { TYPE_COLORS } from '../lib/icons';

const { workspaces, workspace } = Astro.locals;
const notice = Astro.url.searchParams.get('notice');
---
<Base title="Workspaces">
  <h1 class="text-3xl font-bold tracking-tight md:text-4xl">Workspaces</h1>
  <p class="mt-2 text-muted">Separate sets of objects, notes and tags. Types are shared. Links never cross workspaces.</p>
  {notice && <p role="status" class="mt-4 rounded-lg border border-line bg-card px-3 py-2 text-sm text-muted">{notice}</p>}

  <ul class="mt-8 space-y-2">
    {workspaces.map((w) => (
      <li class="rounded-xl border border-line bg-card p-3">
        <form method="post" action="/api/workspaces" class="flex flex-wrap items-center gap-2">
          <input type="hidden" name="id" value={w.id} />
          <span class="h-3 w-3 shrink-0 rounded-full" style={`background:${w.color}`}></span>
          <input name="name" value={w.name} required aria-label="Workspace name" class="field min-w-0 flex-1" />
          <select name="color" aria-label="Color" class="field w-auto">
            {TYPE_COLORS.map((c, i) => <option value={c} selected={w.color === c}>Color {i + 1}</option>)}
          </select>
          <button class="btn" type="submit">Save</button>
          {w.id === workspace.id ? (
            <span class="px-2 text-xs text-muted">Current</span>
          ) : (
            <button class="btn" type="submit" formaction="/api/workspaces/switch">Switch</button>
          )}
        </form>
      </li>
    ))}
  </ul>

  <form method="post" action="/api/workspaces" class="mt-6 flex gap-2">
    <input type="hidden" name="color" value={TYPE_COLORS[workspaces.length % TYPE_COLORS.length]} />
    <input name="name" required autocomplete="off" placeholder="New workspace…" aria-label="New workspace name" class="field flex-1" data-new-object />
    <button class="btn-primary" type="submit"><Icon name="plus" size={16} /> <span class="hidden sm:inline">Add</span></button>
  </form>
</Base>
