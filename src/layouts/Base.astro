---
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import TypeTile from '../components/TypeTile.astro';
import CommandPalette from '../components/react/CommandPalette';
import { listTypes, countByType, listPinned } from '../lib/db';
import { dayLabel } from '../lib/format';

interface Props { title?: string; activeTypeId?: string; activeObjectId?: string; home?: boolean }
const { title = 'Cairn', activeTypeId, activeObjectId, home = false } = Astro.props;
const ws = Astro.locals.workspace;
// 'light' | 'dark' forces a theme; anything else follows the system. A cookie, so the server renders it without a flash.
const themeCookie = Astro.cookies.get('theme')?.value;
const theme = themeCookie === 'light' || themeCookie === 'dark' ? themeCookie : undefined;
const [types, counts, pinned] = await Promise.all([listTypes(ws.id), countByType(ws.id), listPinned(ws.id)]);
const paletteTypes = types.map((t) => ({ id: t.id, name: t.name, slug: t.slug, icon: t.icon, color: t.color }));
---
<!doctype html>
<html lang="en" data-theme={theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {theme ? (
      <meta name="theme-color" content={theme === 'dark' ? '#161514' : '#fafaf9'} />
    ) : (
      <>
        <meta name="theme-color" content="#fafaf9" media="(prefers-color-scheme: light)" />
        <meta name="theme-color" content="#161514" media="(prefers-color-scheme: dark)" />
      </>
    )}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" />
    <title>{title === 'Cairn' ? 'Cairn' : `${title} · Cairn`}</title>
  </head>
  <body class="min-h-screen antialiased">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-2 focus:top-2 focus:z-50 focus:rounded-lg focus:bg-primary focus:px-3 focus:py-2 focus:text-primary-ink">Skip to content</a>

    <header class="sticky top-0 z-30 flex items-center gap-3 border-b border-line bg-page/90 px-4 py-2.5 backdrop-blur md:hidden">
      <button id="menu-btn" class="btn px-2.5" aria-expanded="false" aria-controls="sidebar" aria-label="Menu">
        <Icon name="menu" />
      </button>
      <a href="/" class="flex items-center gap-2 text-[15px] font-semibold">
        <img src="/favicon.svg" alt="" class="logo h-6 w-6" /> KB
      </a>
      <span class="flex items-center gap-1.5 rounded-full border border-line px-2 py-0.5 text-xs text-muted">
        <span class="h-2 w-2 rounded-full" style={`background:${ws.color}`}></span>{ws.name}
      </span>
      <button data-open-palette class="btn ml-auto px-2.5" aria-label="Search"><Icon name="search" /></button>
    </header>

    <div id="scrim" class="fixed inset-0 z-30 hidden bg-black/20 md:hidden"></div>

    <div class="md:grid md:grid-cols-[15.5rem_1fr]">
      <nav id="sidebar" aria-label="Types"
        class="fixed inset-y-0 left-0 z-40 hidden w-64 overflow-y-auto border-r border-line bg-panel px-3 py-4 shadow-xl data-[open=true]:block md:sticky md:top-0 md:block md:h-screen md:w-auto md:shadow-none">
        <a href="/" class="mb-5 flex items-center gap-2.5 px-2 text-[15px] font-semibold">
          <img src="/favicon.svg" alt="" class="logo h-7 w-7" /> KB
        </a>

        <details class="relative mb-3" id="ws-menu">
          <summary class="flex cursor-pointer list-none items-center gap-2.5 rounded-lg px-2 py-1.5 text-sm font-medium hover:bg-hover"
            aria-label={`Workspace: ${ws.name}. Switch workspace`}>
            <span class="h-2.5 w-2.5 rounded-full" style={`background:${ws.color}`}></span>
            <span class="flex-1 truncate">{ws.name}</span>
            <Icon name="chevron-down" size={14} class="text-muted" />
          </summary>
          <div class="absolute inset-x-0 z-50 mt-1 rounded-xl border border-line bg-card p-1.5 shadow-lg">
            {Astro.locals.workspaces.map((w) => (
              <form method="post" action="/api/workspaces/switch">
                <input type="hidden" name="id" value={w.id} />
                <button type="submit" aria-current={w.id === ws.id ? 'true' : undefined}
                  class="flex w-full items-center gap-2.5 rounded-lg px-2.5 py-1.5 text-left text-sm hover:bg-hover aria-[current=true]:font-medium">
                  <span class="h-2.5 w-2.5 rounded-full" style={`background:${w.color}`}></span>
                  <span class="flex-1">{w.name}</span>
                  {w.id === ws.id && <span class="text-xs text-muted">✓</span>}
                </button>
              </form>
            ))}
            <a href="/workspaces" class="mt-1 block rounded-lg border-t border-line px-2.5 py-1.5 pt-2 text-sm text-muted hover:bg-hover hover:text-ink">Manage workspaces</a>
          </div>
        </details>

        <button data-open-palette type="button"
          class="mb-3 flex w-full items-center gap-2.5 rounded-lg border border-line bg-card px-2.5 py-1.5 text-left text-sm text-muted shadow-xs hover:text-ink">
          <Icon name="search" size={15} /> <span class="flex-1">Search</span> <kbd>⌘K</kbd>
        </button>

        <a href="/" aria-current={home ? 'page' : undefined}
          class="mb-4 flex items-center gap-3 rounded-lg px-2 py-1.5 text-sm text-ink/80 hover:bg-hover aria-[current=page]:bg-card aria-[current=page]:font-medium aria-[current=page]:text-ink aria-[current=page]:shadow-xs">
          <span class="flex h-6 w-6 items-center justify-center text-muted"><Icon name="home" size={16} /></span>
          Home
        </a>

        {pinned.length > 0 && (
          <>
            <p class="eyebrow mb-1.5 px-2">Pinned</p>
            <ul class="mb-5 space-y-0.5">
              {pinned.map((o) => (
                <li>
                  <a href={`/o/${o.id}`} aria-current={o.id === activeObjectId ? 'page' : undefined}
                    class="flex items-center gap-3 rounded-lg px-2 py-1.5 text-sm text-ink/80 hover:bg-hover aria-[current=page]:bg-card aria-[current=page]:font-medium aria-[current=page]:text-ink aria-[current=page]:shadow-xs">
                    <TypeTile icon={o.type_icon} color={o.type_color} size="sm" />
                    <span class="flex-1 truncate">{o.type_id === 'type_day' ? dayLabel(o.title) : o.title || 'Untitled'}</span>
                  </a>
                </li>
              ))}
            </ul>
          </>
        )}

        <p class="eyebrow mb-1.5 px-2">Types</p>
        <ul class="space-y-0.5">
          {types.map((t) => (
            <li>
              <a href={`/t/${t.slug}`}
                aria-current={t.id === activeTypeId ? 'page' : undefined}
                class="flex items-center gap-3 rounded-lg px-2 py-1.5 text-sm text-ink/80 hover:bg-hover aria-[current=page]:bg-card aria-[current=page]:font-medium aria-[current=page]:text-ink aria-[current=page]:shadow-xs">
                <TypeTile icon={t.icon} color={t.color} size="sm" />
                <span class="flex-1">{t.name}</span>
                <span class="text-xs tabular-nums text-muted">{counts[t.id] ?? 0}</span>
              </a>
            </li>
          ))}
        </ul>

        <ul class="mt-6 space-y-0.5 border-t border-line pt-4">
          {[['/types', 'sliders', 'Types'], ['/trash', 'archive', 'Trash'], ['/export', 'download', 'Export']].map(([href, icon, label]) => (
            <li>
              <a href={href} aria-current={Astro.url.pathname.startsWith(href) ? 'page' : undefined}
                class="flex items-center gap-3 rounded-lg px-2 py-1.5 text-sm text-ink/70 hover:bg-hover aria-[current=page]:bg-card aria-[current=page]:text-ink aria-[current=page]:shadow-xs">
                <span class="flex h-6 w-6 items-center justify-center text-muted"><Icon name={icon} size={16} /></span>{label}
              </a>
            </li>
          ))}
        </ul>

        <div role="radiogroup" aria-label="Theme" class="mt-6 flex gap-1 rounded-lg bg-hover/70 p-1">
          {([['system', 'monitor', 'System'], ['light', 'sun', 'Light'], ['dark', 'moon', 'Dark']] as const).map(([value, icon, label]) => (
            <button type="button" role="radio" data-theme-choice={value} aria-checked={(theme ?? 'system') === value ? 'true' : 'false'}
              class="flex flex-1 items-center justify-center gap-1.5 rounded-md px-2 py-1 text-xs text-muted hover:text-ink aria-checked:bg-card aria-checked:text-ink aria-checked:shadow-xs"
              title={`${label} theme`}>
              <Icon name={icon} size={14} /><span>{label}</span>
            </button>
          ))}
        </div>

        <p class="mt-4 space-y-1 px-2 text-xs text-muted">
          <span class="block"><kbd>⌘K</kbd> search and commands</span>
          <span class="block"><kbd>n</kbd> new object on a type page</span>
        </p>
      </nav>

      <main id="main" class="mx-auto w-full max-w-3xl px-4 pb-24 pt-6 md:px-10 md:pt-14">
        <slot />
      </main>
    </div>

    <CommandPalette client:load types={paletteTypes} workspaces={Astro.locals.workspaces.map((w) => ({ id: w.id, name: w.name, color: w.color }))} currentWorkspace={ws.id} />

    <script is:inline>
      // Theme: applied live, remembered in a cookie for server rendering. Also used by the palette.
      window.kbSetTheme = (choice) => {
        const root = document.documentElement;
        if (choice === 'light' || choice === 'dark') root.dataset.theme = choice;
        else delete root.dataset.theme;
        document.cookie = choice === 'light' || choice === 'dark'
          ? `theme=${choice}; path=/; max-age=31536000; samesite=lax`
          : 'theme=; path=/; max-age=0; samesite=lax';
        document.querySelectorAll('[data-theme-choice]').forEach((b) =>
          b.setAttribute('aria-checked', String(b.dataset.themeChoice === (root.dataset.theme ?? 'system'))));
        document.querySelectorAll('meta[name=theme-color]').forEach((m) => m.remove());
        const meta = document.createElement('meta');
        meta.name = 'theme-color';
        const dark = root.dataset.theme === 'dark' || (!root.dataset.theme && matchMedia('(prefers-color-scheme: dark)').matches);
        meta.content = dark ? '#161514' : '#fafaf9';
        document.head.appendChild(meta);
      };
      document.querySelectorAll('[data-theme-choice]').forEach((b) => b.addEventListener('click', () => window.kbSetTheme(b.dataset.themeChoice)));
      // Show Ctrl instead of ⌘ outside Apple platforms.
      if (!/Mac|iPhone|iPad/.test(navigator.platform)) document.querySelectorAll('kbd').forEach((k) => { k.textContent = k.textContent.replace('⌘', 'Ctrl '); });
      const nav = document.getElementById('sidebar');
      const scrim = document.getElementById('scrim');
      const btn = document.getElementById('menu-btn');
      const setOpen = (open) => {
        nav.dataset.open = String(open);
        scrim.classList.toggle('hidden', !open);
        btn?.setAttribute('aria-expanded', String(open));
      };
      btn?.addEventListener('click', () => setOpen(nav.dataset.open !== 'true'));
      scrim.addEventListener('click', () => setOpen(false));
      const wsMenu = document.getElementById('ws-menu');
      addEventListener('click', (e) => { if (wsMenu && !wsMenu.contains(e.target)) wsMenu.open = false; });
      addEventListener('keydown', (e) => {
        if (e.key === 'Escape') { if (wsMenu) wsMenu.open = false; return setOpen(false); }
        if (e.key !== 'n' || e.metaKey || e.ctrlKey || e.altKey) return;
        const t = e.target;
        if (t instanceof HTMLElement && (t.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(t.tagName))) return;
        const f = document.querySelector('[data-new-object]');
        if (f) { e.preventDefault(); f.focus(); }
      });
    </script>
  </body>
</html>
