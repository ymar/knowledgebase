{
  "name": "cairn",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "types": "wrangler types",
    "db:migrate": "wrangler d1 migrations apply cairn-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply cairn-db --remote",
    "db:reset": "rm -rf .wrangler/state && npm run db:migrate"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.8",
    "@astrojs/react": "^7.1.9",
    "@tailwindcss/vite": "^4.3.5",
    "astro": "^7.4.12",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "ulid": "^3.0.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^6.0.3",
    "wrangler": "^4.162.0"
  }
}
